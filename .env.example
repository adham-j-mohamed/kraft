# Databas (compose läser denna fil på servern som .env)
POSTGRES_DB=kraft
POSTGRES_USER=kraft
POSTGRES_PASSWORD=byt-mig
DATABASE_URL=postgres://kraft:byt-mig@db:5432/kraft

# Sessionskrypto — 32 byte hex, generera med: openssl rand -hex 32
AUTH_SECRET=byt-mig

# Publik bas-URL (används för OAuth-redirect)
APP_URL=http://localhost:3310

# Google OAuth (Console → Credentials → OAuth client ID → Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Valfritt: tvinga en e-post till adminrollen
ADMIN_EMAIL=
